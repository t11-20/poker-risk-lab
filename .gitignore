node_modules/
dist/
.next/
# Generated by `next dev` / `next build` / `next typegen`. Its contents are an implementation
# detail — it points at whichever dist dir ran last — and Next's own docs say to ignore it and
# never edit it by hand. Tracking it would put a build artefact in every diff.
apps/web/next-env.d.ts
out/
*.tsbuildinfo
coverage/
.env
.env.local
.env.*.local
.DS_Store
docs/sbom/*.json
!docs/sbom/.gitkeep
.pnpm-store/
*.log
/tmp/

# A quarantine candidate lockfile written by `pnpm run deps:quarantine` for review.
# It is a proposal, never the source of truth, and must not be committed.
pnpm-lock.yaml.new

# Belt and braces. `scripts/backup.mjs` defaults PRL_BACKUP_DIR to
# /var/backups/poker-risk-lab, deliberately outside the repository, and a test
# asserts that default is not inside it. This entry covers the one case the
# default cannot: somebody pointing PRL_BACKUP_DIR at ./backups during a
# rehearsal and then running `git add -A`, which would commit an encrypted copy
# of every learner's account.
backups/

# The backup identity's environment file. `deploy/backup/README.md` tells an
# operator to create it from `backup.env.example` and fill in PRL_BACKUP_KEY —
# the key that decrypts every archive ever taken with it — and the backup role's
# database password. `.env` and `deploy/staging/tls/` were both covered here and
# this one was not, so on a backup host `git add -A` would have committed it.
# `scripts/supply-chain/secret-scan.mjs` asserts this rule exists.
deploy/backup/backup.env

# The release signing key and the passphrase that unlocks it.
# `deploy/signing/README.md` tells an operator to create both with
# `pnpm run release:sign --generate-key`, and neither may ever be tracked.
# The PUBLIC half — deploy/signing/cosign.pub — IS committed and is the trust
# anchor `pnpm run security:image-provenance` verifies against; a repository
# that also carried the private half would be handing every reader the ability
# to mint signatures the gate accepts, which is the whole control gone.
# `deploy/backup/backup.env` was matched by no ignore rule until somebody
# checked, and this is the same shape of file on the same kind of host.
# `scripts/supply-chain/secret-scan.mjs` asserts both of these rules exist.
deploy/signing/cosign.key
deploy/signing/signing.env
