{
  "name": "poker-risk-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Poker Risk Lab — an educational play-money No-Limit Hold'em lab for probability, risk/reward, EV and variance. No real money, ever.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.10.0+sha256.620b6605ea4f62fc56a6d0a98733f479071d0321e03e486b522c7e9a74617431",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.10.0 <12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @prl/api dev",
    "dev:web": "pnpm --filter @prl/web dev",
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "clean": "node scripts/clean.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:scripts",
    "test:unit": "pnpm -r --filter \"./packages/**\" --filter @prl/web test",
    "test:integration": "pnpm --filter @prl/api test",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "test:no-database": "pnpm run test:unit && pnpm --filter @prl/api test:without-database && pnpm run test:scripts",
    "test:exhaustive": "pnpm --filter @prl/poker-engine test:exhaustive",
    "test:simulation": "pnpm --filter @prl/poker-ai test:simulation",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:all": "pnpm run test && pnpm run test:exhaustive && pnpm run test:simulation && pnpm run test:a11y",
    "design:contrast": "node scripts/check-contrast.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:wait": "node scripts/db-wait.mjs",
    "db:migrate": "node --env-file-if-exists=.env apps/api/scripts/migrate.mjs up",
    "db:migrate:status": "node --env-file-if-exists=.env apps/api/scripts/migrate.mjs status",
    "db:seed": "node --env-file-if-exists=.env apps/api/scripts/migrate.mjs seed",
    "db:reset": "node --env-file-if-exists=.env apps/api/scripts/migrate.mjs reset",
    "db:setup": "pnpm run db:up && pnpm run db:wait && pnpm run db:migrate && pnpm run db:seed",
    "security:policy": "node scripts/supply-chain/policy-check.mjs",
    "security:denylist": "node scripts/supply-chain/deny-list.mjs",
    "security:shapes": "node scripts/supply-chain/dep-shapes.mjs",
    "security:osv": "node scripts/supply-chain/osv-scan.mjs",
    "security:provenance": "node scripts/supply-chain/provenance.mjs",
    "security:ioc": "node scripts/supply-chain/ioc-scan.mjs",
    "security:sbom": "node scripts/supply-chain/sbom.mjs",
    "security:audit": "node scripts/supply-chain/audit.mjs",
    "deps:quarantine": "node scripts/supply-chain/quarantine.mjs",
    "verify": "pnpm run security:audit && pnpm run security:hygiene && pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run design:contrast && pnpm run test && pnpm run db:verify",
    "security:hygiene": "node scripts/supply-chain/repo-hygiene.mjs",
    "db:verify": "node --env-file-if-exists=.env apps/api/scripts/verify-schema.mjs",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "24.13.3",
    "axe-core": "4.13.0",
    "typescript": "7.0.2"
  }
}
