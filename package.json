{
  "name": "poker-risk-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Poker Risk Lab — an educational play-money No-Limit Hold'em lab for probability, risk/reward, EV and variance. No real money, ever.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.10.0+sha256.620b6605ea4f62fc56a6d0a98733f479071d0321e03e486b522c7e9a74617431",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.10.0 <12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @prl/api dev",
    "dev:web": "pnpm --filter @prl/web dev",
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "clean": "node scripts/clean.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm run build:packages && pnpm run test:unit && pnpm run test:integration && pnpm run test:scripts",
    "test:unit": "pnpm -r --filter \"./packages/**\" --filter @prl/web test",
    "test:integration": "pnpm --filter @prl/api test",
    "test:scripts": "node --test 'scripts/**/*.test.mjs' 'apps/api/scripts/*.test.mjs'",
    "test:no-database": "pnpm run build:packages && pnpm run test:unit && pnpm --filter @prl/api test:without-database && pnpm run test:scripts",
    "test:exhaustive": "pnpm --filter @prl/poker-engine test:exhaustive",
    "test:simulation": "pnpm --filter @prl/poker-ai test:simulation",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "test:keyboard": "PRL_WEB_ORIGIN=http://127.0.0.1:3464 node --env-file-if-exists=.env scripts/keyboard-audit.mjs --start --with-api",
    "test:ax": "PRL_WEB_ORIGIN=http://127.0.0.1:3456 node --env-file-if-exists=.env scripts/ax-tree-audit.mjs --start --with-api",
    "test:csp": "PRL_WEB_ORIGIN=http://127.0.0.1:3457 node scripts/csp-negative-control.mjs --start",
    "test:age-gate": "node scripts/age-gate-audit.mjs",
    "test:layout": "node scripts/text-layout-audit.mjs --start",
    "test:load": "node scripts/load-test.mjs",
    "test:drills": "node --env-file-if-exists=.env scripts/reliability-drills.mjs",
    "test:all": "pnpm run test && pnpm run test:exhaustive && pnpm run test:simulation && pnpm run test:a11y && pnpm run test:ax && pnpm run test:keyboard && pnpm run test:layout",
    "fixtures:regenerate": "node scripts/regenerate-web-fixtures.mjs",
    "fixtures:check": "node scripts/regenerate-web-fixtures.mjs --check",
    "design:contrast": "node scripts/check-contrast.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:wait": "node scripts/db-wait.mjs",
    "db:migrate": "node --env-file-if-exists=.env apps/api/scripts/migrate.mjs up",
    "db:migrate:status": "node --env-file-if-exists=.env apps/api/scripts/migrate.mjs status",
    "db:seed": "node --env-file-if-exists=.env apps/api/scripts/migrate.mjs seed",
    "db:reset": "node --env-file-if-exists=.env apps/api/scripts/migrate.mjs reset",
    "db:setup": "pnpm run db:up && pnpm run db:wait && pnpm run db:migrate && pnpm run db:seed",
    "security:policy": "node scripts/supply-chain/policy-check.mjs",
    "security:denylist": "node scripts/supply-chain/deny-list.mjs",
    "security:shapes": "node scripts/supply-chain/dep-shapes.mjs",
    "security:osv": "node scripts/supply-chain/osv-scan.mjs",
    "security:actions": "node scripts/supply-chain/action-advisories.mjs",
    "security:provenance": "node scripts/supply-chain/provenance.mjs",
    "security:ioc": "node scripts/supply-chain/ioc-scan.mjs",
    "security:sbom": "node scripts/supply-chain/sbom.mjs",
    "security:secrets": "node scripts/supply-chain/secret-scan.mjs",
    "security:audit": "node scripts/supply-chain/audit.mjs",
    "security:pinning": "node scripts/supply-chain/ci-pinning.mjs",
    "security:logs": "node scripts/supply-chain/log-policy.mjs",
    "security:containers": "node scripts/supply-chain/container-scan.mjs",
    "security:image-provenance": "node scripts/supply-chain/image-provenance.mjs",
    "security:keyless": "node scripts/supply-chain/keyless-provenance.mjs",
    "deps:quarantine": "node scripts/supply-chain/quarantine.mjs",
    "verify": "failed=''; for gate in security:audit security:hygiene lint build typecheck design:contrast test test:a11y test:ax test:keyboard test:layout test:csp test:age-gate test:exhaustive test:simulation db:verify; do printf '\\n=== verify gate: %s ===\\n' \"$gate\"; if pnpm run \"$gate\"; then printf '=== PASS %s ===\\n' \"$gate\"; else printf '=== FAIL %s ===\\n' \"$gate\"; failed=\"$failed $gate\"; fi; done; if [ -n \"$failed\" ]; then printf '\\n=== verify FAILED. These gates did not pass:%s ===\\n' \"$failed\" >&2; exit 1; fi; printf '\\n=== verify: every gate passed ===\\n'",
    "security:hygiene": "node scripts/supply-chain/repo-hygiene.mjs",
    "db:roles": "node --env-file-if-exists=.env apps/api/scripts/migrate.mjs roles",
    "db:verify": "node --env-file-if-exists=.env apps/api/scripts/verify-schema.mjs",
    "enrolments": "node --env-file-if-exists=.env apps/api/scripts/enrolments.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "backup": "node scripts/backup.mjs",
    "release:artifacts": "node scripts/release-artifacts.mjs",
    "release:sign": "node --env-file-if-exists=deploy/signing/signing.env scripts/release-sign.mjs",
    "staging": "node scripts/staging.mjs",
    "alerts:unit": "bash deploy/staging/observability/rule-tests/run.sh",
    "alerts:verify": "node scripts/alert-delivery.mjs",
    "alerts:preflight": "node scripts/alert-preflight.mjs",
    "alerts:ack": "node scripts/alert-ack-page.mjs",
    "certify:screen-reader": "node scripts/screen-reader-certify.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.6.4",
    "axe-core": "4.13.0",
    "typescript": "7.0.2"
  }
}
