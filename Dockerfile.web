# Container image for apps/web (the Next.js client).
#
# Read the header of Dockerfile.api first: the base-image digest and its refresh command, Alpine and
# what it requires, the missing `# syntax=` directive, the stage layout, two installs over
# install-then-prune, `COPY . .` over a per-manifest list (`verifyDepsBeforeRun: error`), and the
# symlink farm that keeps every stage at /app all apply here. This header covers what differs.
#
# Same base image and digest as Dockerfile.api: refresh both together, because an api and a web
# container on different base-OS patch levels is a debugging trap for whoever is on call. Next's
# compiler and sharp are this tree's native binaries, and pnpm-lock.yaml carries their musl builds.
#
# ## Why the runtime runs `next start` through the workspace bin shim
#
# /app/apps/web/node_modules/.bin/next is a pnpm-written wrapper that resolves the real entry point.
# A path inside node_modules/.pnpm would embed the peer-dependency hash pnpm appends to that
# directory name (`next@16.3.0_@types+node@…_react@…`), which changes whenever a peer moves.
#
# Not `pnpm start`: running pnpm at container start fires `verifyDepsBeforeRun: error`
# (pnpm-workspace.yaml), which re-verifies the tree against the lockfile on every boot and fails on an
# image whose sources have been removed.
#
# ## If the web app ever sets `output: 'standalone'`
#
# That is the web app's next.config to decide, not this file. If it lands, replace the runtime CMD
# with `["node", "apps/web/.next/standalone/apps/web/server.js"]`, copy `.next/static` and `public`
# into the standalone tree as Next's docs describe, and drop the prod-deps copy from the runtime stage.
#
# ## The runtime working directory is the web app, not the repo root
#
# `next start` with no `--dir` resolves BOTH `next.config.*` and `.next/` from the working directory.
# Inheriting `WORKDIR /app` makes it look for /app/.next, exit 1 with "Could not find a production
# build in the '.next' directory", and crash-loop under `restart: unless-stopped`. The tell: the boot
# log says "Running next.config took Nms" instead of "Running next.config.ts took Nms". The runtime
# stage therefore sets `WORKDIR /app/apps/web` itself, after the (absolute) COPYs; `working_dir:` in
# docker-compose.yml would fix compose only and leave `docker run` broken.
#
# ## Writable paths
#
# `next start` writes to `.next/cache` (ISR revalidation, the image optimiser). The build cache is
# stripped from the image, so with a read-only root the directory comes back as a tmpfs that
# docker-compose.yml mounts at /app/apps/web/.next/cache. Without it, a read-only container serves
# pages but logs EROFS on the first revalidation.

FROM node:24.18.0-alpine3.24@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS base
WORKDIR /app

# Pinned ahead of the base for the same CVEs and on the same terms as Dockerfile.api.
RUN apk add --no-cache --upgrade libcrypto3=3.5.9-r0 libssl3=3.5.9-r0 \
      musl=1.2.6-r3 musl-utils=1.2.6-r3 zlib=1.4-r0

FROM base AS toolchain
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NPM_CONFIG_UPDATE_NOTIFIER=false
RUN corepack enable

# .dockerignore keeps node_modules, dist, .next, coverage, .git, deploy, docs, markdown and .env*
# out of the context at every depth, so this is source and manifests only.
FROM toolchain AS source
COPY . .

# `--filter "@prl/web..."` is the web app plus its workspace dependencies, so
# Fastify, @fastify/* and postgres never enter this image.
FROM source AS prod-deps
RUN pnpm install --frozen-lockfile --prod --ignore-scripts --filter "@prl/web..."
# A deny list, as in Dockerfile.api: worst case a fat image, never a broken one, and the same
# reasons for `tsconfig*.json`, the markdown lines, `docker-compose*.yml`, `.gitignore` and
# `.dockerignore`. `packages/ui/src` goes here with everything else and is put back from the build
# stage: @prl/ui is consumed as source, and restoring the one exception beats a hand-kept package list.
RUN rm -rf \
      apps/*/src apps/*/test apps/*/scripts \
      packages/*/src packages/*/test \
      apps/*/tsconfig*.json packages/*/tsconfig*.json tsconfig.base.json \
      biome.json db .github scripts Dockerfile.api Dockerfile.web \
      docker-compose*.yml .dockerignore .gitignore deploy \
      ./*.md apps/*/*.md packages/*/*.md

FROM source AS build
RUN pnpm install --frozen-lockfile --ignore-scripts --filter "@prl/web..."

# The `/api/*` rewrite destination, and the ONLY build-time setting in this image.
#
# `next build` writes the resolved destination into .next/routes-manifest.json and `next start` reads
# the manifest rather than re-running next.config.ts, so this is frozen at build time. That is why it
# has its own name instead of reusing PRL_API_ORIGIN, which the running server reads for its own
# fetches: one name per lifetime.
#
# Leave it alone for a real deployment, which routes /api/* at the proxy in front of this container
# (docker-compose.yml, docs/RUNBOOK.md §11) and never reaches the rewrite. Set it only for `docker run`
# on a laptop whose API is somewhere other than localhost:3001, with no proxy in play:
#
#     docker build -f Dockerfile.web --build-arg PRL_API_REWRITE_ORIGIN=http://host.docker.internal:3001 .
#
# It is an origin, not a credential, so its value in `docker history` is not a leak. next.config.ts
# refuses to start a production server with it set as a runtime variable, where it would do nothing.
ARG PRL_API_REWRITE_ORIGIN=http://localhost:3001
ENV PRL_API_REWRITE_ORIGIN=${PRL_API_REWRITE_ORIGIN}

# Topological: the workspace packages emit their dist/*.d.ts, packages/ui
# typechecks, then `next build` runs. @prl/ui is consumed as source and
# transpiled by Next, which is why ui has no dist to copy later.
RUN pnpm --filter "@prl/web..." run build
# Reduce this stage to what the runtime lays over prod-deps. `next start` reads no sources or
# tsconfigs, and .next/cache is build cache. Both node_modules trees MUST go: this is a FULL install,
# and landing it on prod-deps' would reinstate every devDependency in the shipped image.
#
# packages/ui/src is the one source tree that stays: @prl/ui resolves its `.` export straight to
# src/index.ts, so the symlink in apps/web/node_modules/@prl/ui needs it to resolve.
#
# Pruning here and copying /app/packages whole below means a new workspace dependency is included
# automatically; a per-package COPY list builds cleanly and dies at boot with ERR_MODULE_NOT_FOUND.
#
# The runtime copies /app/apps/web as one directory, so anything left under it here is published.
# That is why `apps/web/*.md` and `apps/web/test` are on this line even though prod-deps prunes them:
# this stage's tree is laid over the pruned one, and a path pruned only at the bottom comes back.
# `tsconfig*.json`, not `tsconfig.json`, which never matched `tsconfig.test.json`.
RUN rm -rf apps/web/node_modules apps/web/src apps/web/test apps/web/tsconfig*.json apps/web/.next/cache \
      apps/web/*.md packages/*/*.md \
      packages/*/node_modules packages/*/test packages/*/tsconfig*.json \
 && for pkg in packages/*/; do [ "$pkg" = 'packages/ui/' ] || rm -rf "${pkg}src"; done

FROM base AS runtime

# HOSTNAME=0.0.0.0: Next can bind to localhost, and a server on 127.0.0.1 inside a container is
# unreachable from outside it. Safe because the network namespace is the isolation boundary.
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# npm, corepack and yarn are removed for the reasons in the same place in Dockerfile.api; the CMD is a
# pnpm-written shim that execs node and goes near neither. This is a deny list: re-check
# `ls /usr/local/bin /opt` whenever the base changes.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
      /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /opt/yarn-v1.22.22 /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY --from=prod-deps --chown=node:node /app /app
# Every workspace package's dist/, plus packages/content/data and packages/ui/src. COPY merges into
# an existing directory, so prod-deps' node_modules symlink farm survives underneath.
COPY --from=build --chown=node:node /app/packages /app/packages
# Everything the built web app needs: .next, public, next.config.*, package.json.
# Copied as one directory because the exact set (does public/ exist? is the
# config .ts, .mjs or .js?) is the web app's business, not this file's — and a
# COPY of a glob that matches nothing is a build failure, not a no-op.
COPY --from=build --chown=node:node /app/apps/web /app/apps/web

# `next start` resolves next.config.* and .next/ from here. See the header.
WORKDIR /app/apps/web

USER node

EXPOSE 3000

# `/` rather than a health route: the web app is a page server, and "the home page renders" is the
# honest statement of its health. `node -e` and `os.hostname()` for the reasons in Dockerfile.api;
# `os.hostname()` reads the kernel hostname, so it is unaffected by HOSTNAME, Next's bind address.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["node", "-e", "fetch(`http://${require('node:os').hostname()}:${process.env.PORT ?? 3000}/`).then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["/app/apps/web/node_modules/.bin/next", "start"]
