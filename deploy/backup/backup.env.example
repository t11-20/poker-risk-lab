# Poker Risk Lab — the backup identity's environment.
#
# Copy to /etc/poker-risk-lab/backup.env, fill in, then:
#
#   install -o root -g root -m 0600 backup.env /etc/poker-risk-lab/backup.env
#
# 0600 and root-owned is not a formality. systemd reads EnvironmentFile as root before
# dropping to User=prl-backup, so the file does not need to be readable by the backup user —
# and anything that CAN read it can decrypt every archive ever taken with this key.
#
# This file is a template. It contains no real values and must not be committed with any.

# --- Where the archives go -------------------------------------------------
# Must match ReadWritePaths= in prl-backup.service. Put it on a filesystem that is NOT the
# database's: a backup on the disk that just failed is not a backup. Better still, make it a
# mount of remote storage, or replicate it off the host on a schedule of its own.
PRL_BACKUP_DIR=/var/backups/poker-risk-lab

# --- The archive key -------------------------------------------------------
# 32 bytes, base64url. Generate with:
#
#   node scripts/backup.mjs keygen
#
# READ THIS BEFORE YOU SET IT.
#
# An environment variable protects the ARCHIVES, not the HOST. It defends against somebody
# who obtains a copy of the files — a stolen bucket, a cloned volume, a decommissioned disk,
# a snapshot shared with the wrong account. It does not defend against anybody who can read
# this file, read /proc/<pid>/environ, take a core dump of the backup process, or run code on
# this machine while a backup is running.
#
# It also gives you no rotation, no revocation and no audit trail: one key encrypts every
# archive it is used for. If that is not good enough for your deployment, the answer is a KMS
# holding a root key and a per-archive data key wrapped by it — the manifest has an
# `encryption.keyId` field reserved for exactly that, and it is not implemented.
#
# ESCROW A COPY SOMEWHERE THAT IS NOT THIS HOST, AND TEST THE ESCROW. An archive whose key is
# gone is noise. There is no recovery, by design.
PRL_BACKUP_KEY=

# --- The source database ---------------------------------------------------
# The backup identity is its own role. It needs more than the API has and less than a
# superuser:
#
#   * read every table in schema prl        GRANT pg_read_all_data TO prl_backup;
#   * take the cluster globals              pg_dumpall --globals-only needs to read
#                                           pg_authid, which pg_read_all_data covers on
#                                           PostgreSQL 14+. On an older server this step
#                                           needs a superuser, and `create --no-globals` is
#                                           the honest alternative — see the flag's warning.
#   * create a scratch database for
#     `verify --deep`                       ALTER ROLE prl_backup CREATEDB;
#   * own the restored objects              GRANT prl_migrator TO prl_backup;
#                                           (docs/RUNBOOK.md §11.4: without this, a restore
#                                           fails on `ALTER SCHEMA prl OWNER TO prl_migrator`
#                                           with "must be able to SET ROLE")
#
# It must NOT be the role the API connects as, and it must NOT be the cluster superuser.
DATABASE_URL=postgresql://prl_backup:CHANGE_ME@127.0.0.1:5432/poker_risk_lab

# --- Only for a containerised database -------------------------------------
# When PostgreSQL runs in a container and the host has no PostgreSQL 16 client tools,
# pg_dump/pg_restore/psql can be run inside the database container instead. In that mode the
# host and port from DATABASE_URL are the wrong coordinates (they are the published port,
# seen from outside), so the connection goes over the container's unix socket.
#
# Leave this UNSET for a managed database or any host that has the client tools. It requires
# the backup user to be able to talk to the Docker socket, which is root-equivalent on that
# host — a real cost, and the reason it is not the default.
# PRL_BACKUP_PG_CONTAINER=poker-risk-lab-postgres-1

# --- Do not set NODE_ENV here ----------------------------------------------
# `restore` refuses outright when NODE_ENV=production unless it is given a second explicit
# acknowledgement, and that refusal is a feature. Setting NODE_ENV here would make every
# manual restore on this host need the production flag, which is how a flag becomes muscle
# memory and stops meaning anything.
