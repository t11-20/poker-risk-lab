{
  "name": "@prl/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat-native client: a hand against five bots with the Coach, quizzes and the glossary, played with messages and buttons. Telegram and a terminal adapter over one transport-agnostic core.",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "play": "node src/play.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@prl/content": "workspace:*",
    "@prl/contracts": "workspace:*",
    "@prl/poker-ai": "workspace:*",
    "@prl/poker-engine": "workspace:*",
    "@prl/poker-math": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
