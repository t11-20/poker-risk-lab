{
  // Inherits every strictness flag from the root config. Nothing is relaxed for our own code:
  // strict, exactOptionalPropertyTypes, noUncheckedIndexedAccess, noUnusedLocals and the rest all
  // apply to `src/**` exactly as they do in every package.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "incremental": true,
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,

    // The ONE inherited flag this project overrides, and it is a resolution problem rather than a
    // strictness preference.
    //
    // pnpm-workspace.yaml pins `nodeLinker: isolated` with `hoistPattern: []` and
    // `publicHoistPattern: []` — a deliberate supply-chain decision so that no package can reach a
    // dependency it did not declare. A consequence is that `@types/react` is visible from THIS
    // directory (it is our devDependency) and from nowhere else. It is specifically NOT visible
    // from inside `node_modules/.pnpm/next@…/node_modules/next/`, because `next` does not declare
    // it.
    //
    // With `skipLibCheck: false`, tsc type-checks the ~500 `.d.ts` files Next ships, every one of
    // which does `import … from 'react'`. Resolution finds react's JS and no types for it, and the
    // result is 69 x TS7016, 3 x TS2665, 2 x TS2688 and 1 x TS2304 — 75 errors, all of them inside
    // node_modules, none of them about code in this repository, and not one of them fixable from
    // here without either weakening the supply-chain policy or adding a dependency.
    //
    // Next's own `writeConfigurationDefaults` (node_modules/next/dist/lib/typescript/) lists
    // `skipLibCheck: { suggested: true }` and its documented reference tsconfig sets it, so this is
    // the configuration Next expects rather than a workaround invented here.
    //
    // What is lost: type errors inside third-party declaration files. What is kept: every error in
    // `src/**` and in `.next/types/validator.ts`, the generated file that checks each page and
    // layout exports the right shape — a `.ts`, not a `.d.ts`, so `skipLibCheck` does not reach it.
    "skipLibCheck": true,

    "types": ["node", "react", "react-dom"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  // `next-env.d.ts` and `.next/types/**` are both generated by `next build` / `next typegen` and
  // are required members of the program: the first teaches tsc about Next's ambient types, the
  // second carries the route-aware `PageProps` / `LayoutProps` helpers and the export validator.
  //
  // Only the BUILD types are globbed. Next 16 writes dev typegen to `.next/dev/types` and build
  // typegen to `.next/types`, and the two declare the same globals — `AppRoutes`, `ParamMap`,
  // `PageProps`, `LayoutProps` — so a program containing both fails with duplicate-identifier
  // errors. `next-env.d.ts` always points at whichever mode ran last, which makes it the single
  // selector of one set; adding a `.next/dev/types/**` glob here would put the other set in the
  // program alongside it. Run `next build` (or `next typegen`) before `tsc` so the two agree.
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
