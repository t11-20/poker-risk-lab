{
  "name": "@prl/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server-authoritative Fastify API: REST + WebSockets, guest and OIDC auth, private rooms, bots, hand history, Monte Carlo worker pool.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --env-file-if-exists=../../.env --test --test-concurrency=1 'test/**/*.test.ts'",
    "test:without-database": "node --env-file=test/without-database.env --test --test-concurrency=1 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.0",
    "@prl/content": "workspace:*",
    "@prl/contracts": "workspace:*",
    "@prl/poker-ai": "workspace:*",
    "@prl/poker-engine": "workspace:*",
    "@prl/poker-math": "workspace:*",
    "fastify": "5.12.5",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "ws": "8.21.3"
  }
}
