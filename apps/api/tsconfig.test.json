{
  // Typechecks the tests, which `tsconfig.json` cannot.
  //
  // `tsconfig.json` sets `rootDir: "src"` because it emits `dist/`, and TypeScript refuses to
  // compile a file outside `rootDir` (TS6059). So adding `test/**/*.ts` to that config is not an
  // option, and the consequence is that `test/` was checked by nothing: Node 24 runs the tests by
  // *stripping* types, never checking them, so a genuinely broken assertion or a stale helper
  // signature in a test file would pass CI silently until someone ran an editor over it.
  //
  // This config exists only to close that hole. It emits nothing, widens `rootDir` to the package
  // so both trees are legal inputs, and is run by the package's `typecheck` script alongside the
  // build config. Every strict flag is inherited unchanged from `tsconfig.base.json` — this is a
  // second, wider pass, not a laxer one.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Declarations and build info belong to the emitting config; asking for them under `noEmit`
    // is contradictory and `incremental` would fight over the same `.tsbuildinfo` path.
    "declaration": false,
    "declarationMap": false,
    "incremental": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
