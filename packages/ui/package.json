{
  "name": "@prl/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared React components and native CSS for the Poker Risk Lab web app. Consumed as source and transpiled by Next.js.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@prl/contracts": "workspace:*",
    "@prl/poker-math": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
